RDS_HOST=your-rds-host
RDS_PORT=5432
RDS_DB_NAME=your-database-name
RDS_USER=your-database-user
RDS_PASSWORD=your-database-password
RDS_TABLE_NAME=checkpostmaster

# Valid/Invalid Lookup reads RDS_TABLE_NAME (checkpostmaster) only.
# LC/ETC header keywords use a separate table: nhit_file_process (see Portal/db/nhit_file_process.py).
FLASK_SECRET_KEY=replace-with-a-random-secret
